# Copy to .env next to compose.demo.yaml and fill in. .env is ignored by git (B45).

# Public address. For a local try: ABGLEICH_DOMAIN=:80 and ABGLEICH_PUBLIC_URL=http://localhost
ABGLEICH_DOMAIN=abgleich.example.com
ABGLEICH_PUBLIC_URL=https://abgleich.example.com

# Generate with: openssl rand -base64 32
ABGLEICH_DB_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Image to run; the deploy workflow sets the tag to the commit it built.
ABGLEICH_IMAGE=ghcr.io/bakaruu/abgleich
ABGLEICH_IMAGE_TAG=latest
